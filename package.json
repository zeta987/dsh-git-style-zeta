{
  "name": "dsh-git-style-zeta",
  "version": "0.1.0",
  "type": "module",
  "description": "Configurable Git commit and pull request prompt instructions for DeepSeek Harness",
  "license": "MIT",
  "author": {
    "name": "zeta987",
    "url": "https://github.com/zeta987"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zeta987/dsh-git-style-zeta.git"
  },
  "homepage": "https://github.com/zeta987/dsh-git-style-zeta#readme",
  "bugs": {
    "url": "https://github.com/zeta987/dsh-git-style-zeta/issues"
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "dsh",
    "git",
    "prompt",
    "attribution"
  ],
  "engines": {
    "node": ">=22.19.0"
  },
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "README.zh-TW.md",
    "README.zh-CN.md",
    "LICENSE",
    "docs/releasing.md",
    "examples",
    "docs/images"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "check": "node --check lib/index.js && npm test && npm run check:package",
    "check:package": "node scripts/check-package.mjs",
    "test:coverage": "node --experimental-test-coverage --test-coverage-include=lib/*.js --test-coverage-lines=95 --test-coverage-branches=95 --test-coverage-functions=95 --test tests/*.test.mjs"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.2"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.2",
    "@deepseek-ai/dsh-system-prompt": "0.0.1-rc.1",
    "@deepseek-ai/dsh-scope": "0.0.1-rc.1",
    "yaml": "2.9.1"
  }
}
